<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adj_fwmark">
    <property name="upper">4294967295</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adj_jc">
    <property name="upper">65535</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adj_jmax">
    <property name="upper">65534</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adj_jmin">
    <property name="upper">65535</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adj_keepalive">
    <property name="upper">450</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkDialog" id="PeerDialog">
    <property name="width-request">450</property>
    <property name="title" translatable="yes">Edit AmneziaWG Peer</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkRevealer" id="peer_dialog_info_bar">
            <child>
              <object class="GtkLabel" id="peer_dialog_label_info">
                <property name="wrap">True</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Public Key:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="peer_dialog_public_key">
                <property name="tooltip-markup" translatable="yes">Base64-encoded 32-byte public key of the peer.</property>
                <property name="hexpand">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Allowed IPs:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="peer_dialog_allowed_ips">
                <property name="tooltip-markup" translatable="yes">Comma-separated list of IP addresses and prefixes to route through the peer (e.g., 10.0.0.0/24, 0.0.0.0/0 for all IPv4).</property>
                <property name="hexpand">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Endpoint:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="peer_dialog_endpoint">
                <property name="tooltip-markup" translatable="yes">Host:port of the peer endpoint (e.g., vpn.example.com:51820).</property>
                <property name="hexpand">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Preshared Key:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkEntry" id="peer_dialog_psk">
                    <property name="tooltip-markup" translatable="yes">Optional base64-encoded 32-byte preshared key for extra security.</property>
                    <property name="input-purpose">password</property>
                    <property name="hexpand">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="peer_dialog_show_psk">
                    <property name="label" translatable="yes">Show preshared key</property>
                    <property name="use-underline">True</property>
                    <property name="halign">start</property>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Persistent Keepalive:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="peer_dialog_keepalive">
                <property name="tooltip-markup" translatable="yes">Seconds between persistent keepalive packets (0 = disabled, recommended 25).</property>
                <property name="width-chars">5</property>
                <property name="adjustment">adj_keepalive</property>
                <property name="halign">start</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="peer_dialog_advanced_security">
                <property name="label" translatable="yes">_Advanced Security</property>
                <property name="tooltip-markup" translatable="yes">Enable advanced security features for this peer (junk packets, headers, etc.).</property>
                <property name="use-underline">True</property>
                <property name="halign">start</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">5</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <child>
              <object class="GtkButton" id="peer_dialog_button_cancel">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="peer_dialog_button_apply">
                <property name="label" translatable="yes">_Apply</property>
                <property name="sensitive">False</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="adj_listen_port">
