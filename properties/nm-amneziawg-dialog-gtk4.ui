                    </child>
                    <child>
                      <object class="GtkEntry" id="interface_i1_entry">
                        <property name="tooltip-markup" translatable="yes">First init packet content (CPS format). Tags: &amp;lt;r N&amp;gt; (random bytes), &amp;lt;rc N&amp;gt; (random ASCII), &amp;lt;rd N&amp;gt; (random digits), &amp;lt;c&amp;gt; (counter), &amp;lt;t&amp;gt; (timestamp), &amp;lt;b 0xHEX&amp;gt; (static bytes). Example: &amp;lt;r 16&amp;gt;&amp;lt;c&amp;gt;&amp;lt;t&amp;gt;&amp;lt;b 0xDEADBEEF&amp;gt;</property>
                        <property name="width-chars">20</property>
                        <property name="hexpand">1</property>
